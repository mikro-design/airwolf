+/* Isolated embedding API: keys supplied per request by the embedding
+ * application, never read from preferences, never shown in the protocol tree,
+ * and wiped whenever they are replaced or cleared. */
+static bool runtime_enabled;
+static lorawan_runtime_root_key runtime_root_keys[LORAWAN_RUNTIME_MAX_KEYS];
+static lorawan_runtime_session_key runtime_session_keys[LORAWAN_RUNTIME_MAX_KEYS];
+static unsigned runtime_root_count, runtime_session_count;
+
+static void
+runtime_wipe(void *p, size_t n)
+{
+	volatile uint8_t *v = (volatile uint8_t *)p;
+	while (n--) *v++ = 0;
+}
+
+bool
+lorawan_runtime_configure(const lorawan_runtime_root_key *roots, unsigned root_count,
+	const lorawan_runtime_session_key *sessions, unsigned session_count)
+{
+	runtime_wipe(runtime_root_keys, sizeof runtime_root_keys);
+	runtime_wipe(runtime_session_keys, sizeof runtime_session_keys);
+	runtime_root_count = runtime_session_count = 0;
+	runtime_enabled = true;
+	if (root_count > LORAWAN_RUNTIME_MAX_KEYS || session_count > LORAWAN_RUNTIME_MAX_KEYS ||
+	    (root_count && !roots) || (session_count && !sessions))
+		return false;
+	if (root_count) memcpy(runtime_root_keys, roots, root_count * sizeof *roots);
+	if (session_count) memcpy(runtime_session_keys, sessions, session_count * sizeof *sessions);
+	runtime_root_count = root_count;
+	runtime_session_count = session_count;
+	return true;
+}
 
+/* Key lookups for both sources. In runtime mode only the supplied keys count. */
+static unsigned
+root_key_count(void)
+{
+	return runtime_enabled ? runtime_root_count : root_num_keys;
+}
+
+static const uint8_t *
+root_appkey_at(unsigned index)
+{
+	return runtime_enabled ? runtime_root_keys[index].appkey : root_keys[index].appkey->data;
+}
