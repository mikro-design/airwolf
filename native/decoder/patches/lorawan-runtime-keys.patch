+/* packet-lorawan.h
+ * Runtime key API for applications that embed the LoRaWAN dissector.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef __PACKET_LORAWAN_H__
+#define __PACKET_LORAWAN_H__
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "ws_symbol_export.h"
+
+#define LORAWAN_RUNTIME_MAX_KEYS 32
+
+/* DevEUI in on-air (little-endian) byte order. */
+typedef struct {
+	uint8_t deveui[8];
+	uint8_t appkey[16];
+} lorawan_runtime_root_key;
+
+/* DevAddr as the 32-bit value read little-endian from the frame header. */
+typedef struct {
+	uint32_t dev_addr;
+	uint8_t nwkskey[16];
+	uint8_t appskey[16];
+} lorawan_runtime_session_key;
+
+/* Replaces (and wipes) the runtime keys and enables runtime mode, in which the
+ * key preference tables are ignored. Call with no keys to wipe them. */
+WS_DLL_PUBLIC bool lorawan_runtime_configure(const lorawan_runtime_root_key *roots, unsigned root_count,
+	const lorawan_runtime_session_key *sessions, unsigned session_count);
+
+#endif /* __PACKET_LORAWAN_H__ */
