 /* Program Constants */
 #define ZBEE_SEC_PC_KEY             0
 
+/* Request-scoped native application key API. No UAT or profile files are read.
+ * Call only between epan sessions; NULL/0 clears and wipes all supplied keys.
+ * kind: 0 network, 1 link; flags: 1 PAN, 2 source EUI64, 4 key sequence.
+ * id is an opaque application identifier, never a key-derived value. */
+typedef struct {
+    uint8_t key[16];
+    uint32_t id;
+    uint64_t source;
+    uint16_t pan;
+    uint8_t kind, flags, sequence;
+} zbee_runtime_key;
+WS_DLL_PUBLIC bool zbee_sec_runtime_configure(const zbee_runtime_key *, unsigned, unsigned);
+
