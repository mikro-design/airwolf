+/* Isolated embedding API: scoped keys, no sniffed/preference fallback, no secret
+ * values in the protocol tree. Kept out of capture/export data entirely. */
+static bool runtime_enabled;
+static zbee_runtime_key runtime_keys[32];
+static unsigned runtime_key_count, runtime_level = ZBEE_SEC_ENC_MIC32;
+typedef struct { uint16_t pan, short_addr; uint64_t source; uint32_t frame; } runtime_address;
+static runtime_address runtime_addresses[1024];
+static unsigned runtime_address_count;
+typedef struct { uint64_t source; bool valid; } runtime_nonce_hint;
+static const value_string runtime_auth_names[] = {
+    {1, "Authenticated"},
+    {2, "Key unavailable"},
+    {3, "No key matches the security selectors"},
+    {4, "Authentication failed (wrong key or damaged message/MIC)"},
+    {5, "Source EUI64 unavailable; nonce cannot be constructed"},
+    {6, "Security level provides no authentication; payload not trusted"},
+    {7, "Truncated secured payload or MIC"},
+    {0, NULL}
+};
+static void runtime_wipe(void *p, size_t n) {
+    volatile uint8_t *v = (volatile uint8_t *)p;
+    while (n--) *v++ = 0;
+}
+bool zbee_sec_runtime_configure(const zbee_runtime_key *keys, unsigned count, unsigned level) {
+    runtime_wipe(runtime_keys, sizeof runtime_keys);
+    runtime_key_count = 0;
+    runtime_address_count = 0;
+    runtime_enabled = true;
+    if (count > 32 || (count && !keys) || level > 7) return false;
+    for (unsigned i = 0; i < count; i++) {
+        if (keys[i].kind > 1 || (keys[i].flags & ~7) ||
+            (keys[i].kind && (keys[i].flags & 4))) return false;
+    }
+    if (count) memcpy(runtime_keys, keys, count * sizeof *keys);
+    runtime_key_count = count;
+    runtime_level = level;
+    return true;
+}
